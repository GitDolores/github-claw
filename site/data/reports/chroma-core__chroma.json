  "pitfalls": [
    {
      "pit": "环境不隔离：直接在系统 Python/node 里装依赖，装到一半互相打架",
      "fix": "先建 venv / 用 nvm 固定版本，再装依赖"
    },
    {
      "pit": "CUDA/驱动不匹配：torch 装了 CUDA 12 版本但驱动只支持 11",
      "fix": "先 nvidia-smi 看驱动支持的上限，再选对应版本安装"
    },
    {
      "pit": "模型文件放错目录：程序默认去 ./models 找，你下到了下载文件夹",
      "fix": "先跑一次看报错里的路径，把文件挪过去"
    },
    {
      "pit": "文档没切块直接塞，检索质量稀烂",
      "fix": "按段落/固定 token 数切块，保留标题上下文"
    },
    {
      "pit": "embedding 模型和问答模型语言不一致",
      "fix": "中文语料用中文/多语 embedding 模型"
    },
    {
      "pit": "只看 top-1 检索结果，答非所问",
      "fix": "top-k 调到 3~5 并加相似度阈值"
    },
    {
      "pit": "容器里 GPU 用不了：没装 nvidia-container-toolkit",
      "fix": "装 toolkit 并用 --gpus all 参数启动"
    }
  ],
